    '.tiff', '.svg', '.mhtml', '.mht', '.srt', '.vtt', '.ass', '.ssa', '.lrc'
}

def normalize_source(text):
    text = (text or '').strip()
    if ID_RE.fullmatch(text):
        text = 'https://www.youtube.com/watch?v=' + text
    if not text or len(text) > 4096:
        return None
    try:
        u = urllib.parse.urlsplit(text)
        if u.scheme.lower() not in ('http', 'https') or not u.hostname or u.username or u.password:
            return None
        host = u.hostname.lower().rstrip('.')
        if host == 'localhost' or host.endswith(('.localhost', '.local')):
            return None
        import ipaddress
        try:
            if not ipaddress.ip_address(host).is_global:
                return None
        except ValueError:
            pass
        return text
    except (ValueError, UnicodeError):
        return None

def card(vid, e):
    return {'id': vid, 'url': 'https://www.youtube.com/watch?v=' + vid,
            'title': e.get('title') or vid,
            'ch': e.get('channel') or e.get('uploader') or '',
            'dur': e.get('duration'),
            'th': 'https://i.ytimg.com/vi/%s/mqdefault.jpg' % vid}

def yt_search(q):
    q = ' '.join((q or '').split())[:100]
    if not q:
        return []
    p = subprocess.run([YT, '--flat-playlist', '-J', '--no-warnings', '--no-call-home',
                        '--socket-timeout', '15', 'ytsearch12:' + q],
                       capture_output=True, text=True, timeout=75)
    data = json.loads(p.stdout or '{}')
    out = []
    for e in data.get('entries') or []:
        vid = e.get('id')
        if vid and ID_RE.fullmatch(vid):
            out.append(card(vid, e))
    return out

def yt_info(url):
    url = normalize_source(url)
    if not url:
        raise ValueError('Enlace HTTP(S) no válido')
    p = subprocess.run([YT, '-J', '--no-playlist', '--no-warnings', '--no-call-home',
                        '--socket-timeout', '20', url],
                       capture_output=True, text=True, timeout=90)
    data = json.loads(p.stdout or '{}')
    formats = []
    for f in data.get('formats') or []:
        fid = str(f.get('format_id') or '')
        if not FORMAT_ID_RE.fullmatch(fid):
            continue
        vc = str(f.get('vcodec') or 'none')
        ac = str(f.get('acodec') or 'none')
        if vc != 'none' and ac != 'none':
            kind = 'video+audio'
        elif vc != 'none':
            kind = 'video'
        elif ac != 'none':
            kind = 'audio'
        else:
            kind = 'archivo'
        resolution = f.get('resolution') or ''
        if not resolution and (f.get('width') or f.get('height')):
            resolution = '%s×%s' % (f.get('width') or '?', f.get('height') or '?')
        size = f.get('filesize') or f.get('filesize_approx') or 0
        size_approx = not bool(f.get('filesize'))
        try:
            size = int(size)
        except (TypeError, ValueError):
            size = 0
        try:
            height = int(f.get('height') or 0)
        except (TypeError, ValueError):
            height = 0
        formats.append({'id': fid, 'ext': str(f.get('ext') or ''),
                        'resolution': str(resolution), 'note': str(f.get('format_note') or ''),
                        'kind': kind, 'vcodec': vc, 'acodec': ac,
                        'fps': f.get('fps') or '', 'height': height, 'size': size,
                        'size_approx': size_approx,
                        'tbr': f.get('tbr') or ''})
    source = data.get('webpage_url') or data.get('original_url') or url
    return {'id': str(data.get('id') or source), 'url': source,
            'title': data.get('title') or data.get('id') or source,
            'ch': data.get('channel') or data.get('uploader') or data.get('creator') or '',
            'dur': data.get('duration'), 'th': data.get('thumbnail') or '',
            'formats': formats}

def run_job(jid, url, fmt):
    j = JOBS[jid]
    with JOBS_SEM:
        j['status'] = 'running'
        os.makedirs(DEST, exist_ok=True)
        download_args = []
        if fmt == 'best':
            selector = 'bv*+ba/b' if FFMPEG else 'best'
        elif fmt in ('video1080', 'video720', 'video480'):
            cap = {'video1080': 1080, 'video720': 720, 'video480': 480}[fmt]
            selector = ('bv*[height<=%d]+ba/b[height<=%d]/best[height<=%d]' % (cap, cap, cap)
                        if FFMPEG else 'best[height<=%d]' % cap)
        elif fmt == 'audio':
            selector = 'bestaudio/best'
        elif fmt in ('audio_mp3', 'audio_m4a', 'audio_flac'):
            selector = 'bestaudio/best'
            download_args = ['-x', '--audio-format', fmt.rsplit('_', 1)[1]]
        else:
            selector = fmt
        cmd = [YT, '--no-playlist', '--newline', '--progress', '--no-warnings',
               '--no-call-home', '--windows-filenames',
               '-o', os.path.join(DEST, '%(title).120B [%(id)s].%(ext)s')] + download_args + \
              ['--print', 'after_move:filepath', '-f', selector, url]
        last = ''
        proc = None
        timer = None
        try:
            proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                    text=True, bufsize=1, errors='replace')
            timer = threading.Timer(1800, proc.kill)
            timer.start()
            for line in proc.stdout:
                line = line.strip()
                if not line:
                    continue
                m = re.search(r'\[download\]\s+([\d.]+)%', line)
                if m:
                    j['pct'] = float(m.group(1))
                elif line.startswith('[ExtractAudio]') or line.startswith('[Merger]') or 'Post-process' in line:
                    j['msg'] = 'Procesando el formato...'
                    j['pct'] = 100.0
                elif os.path.isabs(line) and os.path.isfile(line):
                    j['file'] = os.path.basename(line)
                elif line.startswith('ERROR'):
                    last = line[:240]
            proc.wait()
        except Exception as ex:
            last = str(ex)[:240]
        finally:
            if timer:
                timer.cancel()
        if j.get('file') and proc is not None and proc.returncode == 0:
            j['status'] = 'done'
            j['pct'] = 100.0
            sys.stderr.write('DESCARGADO %s\n' % j['file'])
            sys.stderr.flush()
        else:
            j['status'] = 'error'
            j['msg'] = last or 'No se pudo descargar. Comprueba el enlace, el formato y si el contenido requiere acceso.'

def list_library():
    out = []
    try:
        for n in os.listdir(DEST):
            fp = os.path.join(DEST, n)
            if n.startswith('.') or not os.path.isfile(fp):
                continue
            if os.path.splitext(n)[1].lower() in LIB_EXT:
                st = os.stat(fp)
                out.append({'n': n, 's': st.st_size, 't': st.st_mtime})
    except OSError:
        pass
    out.sort(key=lambda x: -x['t'])
    return out[:200]
