    fi
    (( EXPIRA_MIN > 0 )) && printf ' %s⏳ %s%s\n' "$C_Y" "$(trans "Se cierra solo en $EXPIRA_MIN min")" "$C_0"
    (( MAX_ACCESOS > 0 )) && printf ' %s🎯 %s%s\n' "$C_Y" "$(trans "Se cierra tras $MAX_ACCESOS apertura(s)")" "$C_0"
    bar
    if command -v termux-clipboard-set >/dev/null 2>&1; then
