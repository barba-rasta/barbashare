        printf ' 📄 %s %s\n' "$(trans 'Portada:')" "$(short "${SEL[0]}/index.html")"
        printf ' 📦 %s\n\n' "$(trans 'Recursos estáticos: archivos de esta carpeta')"
        printf ' %s🔗 %s%s\n\n' "$C_G" "$(trans 'Comparte este enlace para abrir tu página:')" "$C_0"
    else
