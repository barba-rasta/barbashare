<script>
const FILES=__DATA__;
/* ---------- utilidades puras (ID3, letras, subtítulos) ---------- */
function s4(b,o){return ((b[o]&127)<<21)|((b[o+1]&127)<<14)|((b[o+2]&127)<<7)|(b[o+3]&127);}
function be4(b,o){return b[o]*16777216+(b[o+1]<<16)+(b[o+2]<<8)+b[o+3];}
function dec(enc,b){
  let e='windows-1252';
  if(enc===1){
    if(b[0]===0xFF&&b[1]===0xFE){e='utf-16le';b=b.subarray(2);}
    else if(b[0]===0xFE&&b[1]===0xFF){e='utf-16be';b=b.subarray(2);}
    else e='utf-16le';
  }else if(enc===2)e='utf-16be';
  else if(enc===3)e='utf-8';
  try{return new TextDecoder(e).decode(b).replace(/\0+$/,'').replace(/\0/g,' / ');}catch(_){return '';}
}
function parseID3(b){
  if(b.length<10||b[0]!==73||b[1]!==68||b[2]!==51)return null;
  const ver=b[3]; if(ver<3||ver>4)return null;
  const size=s4(b,6); let p=10; const end=Math.min(10+size,b.length);
  if(b[5]&0x40){p+=ver===4?s4(b,p):be4(b,p)+4;}
  const t={};
  while(p+10<=end){
    const id=String.fromCharCode(b[p],b[p+1],b[p+2],b[p+3]);
    if(!/^[A-Z0-9]{4}$/.test(id))break;
    const fs=ver===4?s4(b,p+4):be4(b,p+4);
    const body=b.subarray(p+10,Math.min(p+10+fs,end));
    p+=10+fs;
    if(!body.length)continue;
    if(id==='TIT2')t.title=dec(body[0],body.subarray(1));
    else if(id==='TPE1')t.artist=dec(body[0],body.subarray(1));
    else if(id==='TALB')t.album=dec(body[0],body.subarray(1));
    else if(id==='APIC'&&!t.pic){
      const enc=body[0]; let q=1;
      while(q<body.length&&body[q]!==0)q++;
      let mime=''; for(let i=1;i<q;i++)mime+=String.fromCharCode(body[i]);
      q+=2;
      if(enc===1||enc===2){while(q+1<body.length&&!(body[q]===0&&body[q+1]===0))q+=2;q+=2;}
      else{while(q<body.length&&body[q]!==0)q++;q+=1;}
      t.pic={mime:mime.indexOf('image/')===0?mime:'image/jpeg',data:body.subarray(q)};
    }
  }
  return t;
}
function parseLRC(txt){
  const out=[];
  txt.split(/\r?\n/).forEach(l=>{
    const tags=[...l.matchAll(/\[(\d+):(\d+(?:\.\d+)?)\]/g)];
    if(!tags.length)return;
    const s=l.replace(/\[[^\]]*\]/g,'').trim();
    tags.forEach(m=>out.push({t:Number(m[1])*60+Number(m[2]),s:s}));
  });
  return out.sort((a,b)=>a.t-b.t);
}
function srt2vtt(t){return 'WEBVTT\n\n'+t.replace(/\r/g,'').replace(/(\d{2}:\d{2}:\d{2}),(\d{3})/g,'$1.$2');}
function fmt(t){
  if(!isFinite(t)||t<0)t=0; t=Math.floor(t);
  const h=Math.floor(t/3600),m=Math.floor(t%3600/60),s=t%60;
  return (h?h+':'+String(m).padStart(2,'0'):m)+':'+String(s).padStart(2,'0');
}
function sz(n){const u=['B','KB','MB','GB'];let i=0;while(n>=1024&&i<3){n/=1024;i++;}return (i?n.toFixed(1):n)+' '+u[i];}
/*DOM*/
const $=id=>document.getElementById(id);
const med=FILES.filter(f=>f.k!=='o'), oth=FILES.filter(f=>f.k==='o');
const ICON={a:'🎵',v:'🎬',i:'🖼',o:'📄'};
const SPEEDS=[1,1.25,1.5,2,0.75];
const SL=[0,15,30,60];
const BASE_TITLE=document.title;
let slpI=0, slpT=null, stageOut=false;
let pos=-1, shuf=false, loopMode=1, spd=0, tok=0, dragging=false, lrc=[], lrcOn=-1, hist=[];
const A=new Audio(), V=document.createElement('video'), I=document.createElement('img');
A.preload='auto'; V.preload='metadata'; V.controls=true; V.playsInline=true; I.alt='';
V.hidden=true; I.hidden=true; $('vwrap').appendChild(V); $('vwrap').appendChild(I);
let blobUrl=null;
const cur=()=>med[pos]&&(med[pos].k==='a'?A:med[pos].k==='v'?V:null);

function row(f,cls){
  const li=document.createElement('li'); li.className=cls;
  const t=document.createElement('div'); t.className='t';
  const n=document.createElement('div'); n.className='n'; n.textContent=ICON[f.k]+' '+f.n;
  const s=document.createElement('div'); s.className='s'; s.textContent=sz(f.s);
  t.appendChild(n); t.appendChild(s);
  const a=document.createElement('a'); a.href=f.u; a.setAttribute('download',f.b); a.textContent='⬇'; a.title='Descargar';
  li.appendChild(t); li.appendChild(a);
  li._txt=(f.n+' '+f.p).toLowerCase();
  return li;
}

function setMode(k){
  const aud=k==='a', vid=k==='v', img=k==='i';
  $('art').hidden=!aud; V.hidden=!vid; I.hidden=!img; $('vwrap').hidden=aud;
  $('seekrow').hidden=!aud; $('pp').hidden=!aud; $('back').hidden=!aud; $('fwd').hidden=!aud;
  $('spd').hidden=img; $('vol').hidden=!aud; $('slp').hidden=img;
  $('kar').hidden=true; $('kbar').hidden=true; $('lyr').classList.remove('full');
}

function setCover(url){
  const c=$('cover');
  if(!url){c.hidden=true;$('ph').hidden=false;$('stage').style.removeProperty('--g');return;}
  c.onload=()=>{
    c.hidden=false;$('ph').hidden=true;
    try{
      const cv=document.createElement('canvas');cv.width=cv.height=8;
      const x=cv.getContext('2d');x.drawImage(c,0,0,8,8);
      const d=x.getImageData(0,0,8,8).data;let r=0,g=0,b=0;
      for(let i=0;i<d.length;i+=4){r+=d[i];g+=d[i+1];b+=d[i+2];}
      const n=d.length/4;
      $('stage').style.setProperty('--g','rgb('+Math.round(r/n*.55)+','+Math.round(g/n*.55)+','+Math.round(b/n*.55)+')');
    }catch(_){}
  };
  c.onerror=()=>{c.hidden=true;$('ph').hidden=false;};
  c.src=url;
}

async function readTags(u){
  const lo={headers:{Range:'bytes=0-262143'},priority:'low'};
  const r1=await fetch(u,lo);
  let b=new Uint8Array(await r1.arrayBuffer());
  if(b.length<10||b[0]!==73||b[1]!==68||b[2]!==51)return null;
  const need=10+s4(b,6);
  if(need>2097152)return parseID3(b);
  if(need>b.length){
    const r2=await fetch(u,{headers:{Range:'bytes='+b.length+'-'+(need-1)},priority:'low'});
    const rest=new Uint8Array(await r2.arrayBuffer());
    const all=new Uint8Array(b.length+rest.length); all.set(b,0); all.set(rest,b.length); b=all;
  }
  return parseID3(b);
}

function mediaSession(f,art){
  if(!('mediaSession' in navigator))return;
  try{
    navigator.mediaSession.metadata=new MediaMetadata({title:$('ttl').textContent,artist:$('sub').textContent,
      album:'BarbaShare · by Jorge Barba',artwork:art?[{src:art,sizes:'512x512'}]:[]});
    const h=(a,fn)=>{try{navigator.mediaSession.setActionHandler(a,fn);}catch(_){}};
    h('previoustrack',prev); h('nexttrack',next);
    h('play',()=>A.play()); h('pause',()=>A.pause());
    h('seekbackward',()=>{A.currentTime=Math.max(0,A.currentTime-10);});
    h('seekforward',()=>{A.currentTime+=10;});
    h('seekto',e=>{A.currentTime=e.seekTime;});
  }catch(_){}
}

async function loadMeta(f,my){
  let art=f.c||null;
  try{
    const t=await readTags(f.u);
    if(my!==tok)return;
    if(t){
      if(t.title)$('ttl').textContent=t.title;
      const sub=[t.artist,t.album].filter(Boolean).join(' · ');
      if(sub)$('sub').textContent=sub;
      if(t.pic&&t.pic.data.length){
        if(blobUrl)URL.revokeObjectURL(blobUrl);
        blobUrl=URL.createObjectURL(new Blob([t.pic.data],{type:t.pic.mime}));
        art=blobUrl;
      }
    }
  }catch(_){}
  if(my!==tok)return;
  setCover(art);
  mediaSession(f,art);
}

function renderLyrics(txt,ext){
  const box=$('lyr'); box.innerHTML=''; lrc=[]; lrcOn=-1;
  if(ext==='.lrc'||/\[\d+:\d+(\.\d+)?\]/.test(txt)){
    lrc=parseLRC(txt);
    if(lrc.length){
      lrc.forEach((l,i)=>{const d=document.createElement('div');d.textContent=l.s||'♪';d.onclick=()=>{A.currentTime=l.t;};box.appendChild(d);});
      box.hidden=false; $('kar').hidden=false; return;
    }
  }
  const pre=document.createElement('pre'); pre.textContent=txt.trim();
  box.appendChild(pre); box.hidden=!txt.trim();
}
function syncLyrics(){
  if(!lrc.length)return;
  const t=A.currentTime+0.25; let i=-1;
  for(let k=0;k<lrc.length;k++){if(lrc[k].t<=t)i=k;else break;}
  if(i===lrcOn)return;
  const box=$('lyr'), kids=box.children;
  if(lrcOn>=0&&kids[lrcOn])kids[lrcOn].classList.remove('on');
  lrcOn=i;
  if(i>=0&&kids[i]){kids[i].classList.add('on');box.scrollTo({top:kids[i].offsetTop-box.clientHeight/2+kids[i].clientHeight/2});}
}

function stopAll(){
  A.pause(); V.pause(); V.removeAttribute('src'); I.removeAttribute('src');
  while(V.firstChild)V.removeChild(V.firstChild);
  $('lyr').hidden=true; $('lyr').innerHTML=''; lrc=[]; lrcOn=-1; $('kar').hidden=true; $('kbar').hidden=true; $('lyr').classList.remove('full');
}

function play(i,auto,scroll){
  if(i<0||i>=med.length)return;
  const my=++tok; pos=i; const f=med[i];
  stopAll(); setMode(f.k);
  $('ttl').textContent=f.n; $('sub').textContent=f.p||''; $('dl').href=f.u; $('dl').setAttribute('download',f.b);
  $('stage').hidden=false;
  document.querySelectorAll('#list li.m').forEach(li=>li.classList.toggle('cur',Number(li.dataset.i)===i));
  const rate=SPEEDS[spd];
  if(f.k==='a'){
    setCover(f.c||null);
    A.src=f.u; A.defaultPlaybackRate=rate; A.playbackRate=rate;
    if(auto){const p=A.play(); if(p&&p.catch)p.catch(()=>{});}
    setTimeout(()=>{
      if(my!==tok)return;
      loadMeta(f,my);
      if(f.l){
        fetch(f.l).then(r=>r.text()).then(t=>{if(my===tok)renderLyrics(t,f.lx);}).catch(()=>{});
      }
    },auto?900:350);
  }else if(f.k==='v'){
    V.src=f.u; V.defaultPlaybackRate=rate; V.playbackRate=rate;
    if(f.l&&(f.lx==='.vtt'||f.lx==='.srt')){
      fetch(f.l).then(r=>r.text()).then(t=>{
        if(my!==tok)return;
        const tr=document.createElement('track'); tr.kind='subtitles'; tr.label='Subtítulos'; tr.srclang='es'; tr.default=true;
        tr.src=URL.createObjectURL(new Blob([f.lx==='.srt'?srt2vtt(t):t],{type:'text/vtt'}));
        V.appendChild(tr);
      }).catch(()=>{});
    }
    if(auto){const p=V.play(); if(p&&p.catch)p.catch(()=>{});}
    mediaSession(f,null);
  }else{
    I.src=f.u;
    const nx=med[(i+1)%med.length]; if(nx&&nx.k==='i'){const pre=new Image(); pre.src=nx.u;}
  }
  upd();
  if(scroll)$('stage').scrollIntoView({behavior:'smooth',block:'start'});
}

function nxt(){
  if(loopMode===2)return pos;
  if(shuf&&med.length>1){let j;do{j=Math.floor(Math.random()*med.length);}while(j===pos);return j;}
  const j=pos+1; return j>=med.length?(loopMode===1?0:-1):j;
}
function next(){const j=nxt(); if(j>=0){hist.push(pos);play(j,true);}}
function prev(){
  const c=cur();
  if(c&&c.currentTime>3){c.currentTime=0;return;}
  if(shuf&&hist.length){play(hist.pop(),true);return;}
  play(pos>0?pos-1:(loopMode===1?med.length-1:0),true);
}
function ended(){ if(med[pos]&&med[pos].k!=='i')next(); }
A.addEventListener('ended',ended); V.addEventListener('ended',ended);
function upd(){
  $('pp').textContent=A.paused?'▶':'⏸';
  $('shuf').classList.toggle('on',shuf);
  $('loop').classList.toggle('on',loopMode>0);
  $('loop').textContent=loopMode===2?'🔂':'🔁';
  $('spd').textContent=(SPEEDS[spd]+'×').replace('0.75','¾');
  $('slp').textContent=SL[slpI]?('😴 '+SL[slpI]+'m'):'😴';
  $('mpp').textContent=A.paused?'▶':'⏸';
  document.title=(!A.paused&&med[pos]?'▶ '+$('ttl').textContent+' · ':'')+BASE_TITLE;
  miniUpd();
}
function miniUpd(){
  const show=stageOut&&pos>=0&&med[pos]&&med[pos].k==='a';
  $('mini').hidden=!show;
  if(show)$('mtt').textContent=$('ttl').textContent;
}
A.addEventListener('play',upd); A.addEventListener('pause',upd);
A.addEventListener('loadedmetadata',()=>{$('td').textContent=fmt(A.duration);});
A.addEventListener('timeupdate',()=>{
  if(!dragging&&isFinite(A.duration)&&A.duration>0){
    $('seek').value=Math.round(A.currentTime/A.duration*1000);
    const pc=(A.currentTime/A.duration*100).toFixed(1)+'%';
    $('seek').style.setProperty('--p',pc); $('mp').style.width=pc;
    $('tc').textContent=fmt(A.currentTime); $('td').textContent=fmt(A.duration);
  }
  syncLyrics();
  try{if('mediaSession' in navigator&&isFinite(A.duration))navigator.mediaSession.setPositionState({duration:A.duration,position:A.currentTime,playbackRate:A.playbackRate});}catch(_){}
});
$('seek').addEventListener('input',()=>{dragging=true;$('seek').style.setProperty('--p',($('seek').value/10)+'%');if(isFinite(A.duration))$('tc').textContent=fmt($('seek').value/1000*A.duration);});
$('seek').addEventListener('change',()=>{if(isFinite(A.duration))A.currentTime=$('seek').value/1000*A.duration;dragging=false;});
$('pp').onclick=()=>{A.paused?A.play().catch(()=>{}):A.pause();};
$('back').onclick=()=>{A.currentTime=Math.max(0,A.currentTime-10);};
$('fwd').onclick=()=>{A.currentTime=Math.min(A.duration||1e9,A.currentTime+10);};
$('prev').onclick=prev; $('next').onclick=next;
$('shuf').onclick=()=>{shuf=!shuf;hist=[];upd();};
$('loop').onclick=()=>{loopMode=(loopMode+1)%3;upd();};
$('spd').onclick=()=>{spd=(spd+1)%SPEEDS.length;const r=SPEEDS[spd];A.defaultPlaybackRate=A.playbackRate=r;V.defaultPlaybackRate=V.playbackRate=r;upd();};
$('vol').oninput=()=>{A.volume=V.volume=$('vol').value/100;};
$('slp').onclick=()=>{
  slpI=(slpI+1)%SL.length; clearTimeout(slpT); slpT=null;
  if(SL[slpI])slpT=setTimeout(()=>{A.pause();V.pause();slpI=0;upd();},SL[slpI]*60000);
  upd();
};
$('shr').onclick=()=>{
  const url=location.href, ok=()=>{$('shr').textContent='✔';setTimeout(()=>{$('shr').textContent='📤';},1500);};
  if(navigator.share){navigator.share({title:BASE_TITLE,url:url}).catch(()=>{});}
  else if(navigator.clipboard){navigator.clipboard.writeText(url).then(ok).catch(()=>{});}
};
function karaoke(on){
  $('lyr').classList.toggle('full',on); $('kbar').hidden=!on;
  document.body.style.overflow=on?'hidden':'';
  if(on){lrcOn=-1;syncLyrics();}
}
$('kar').onclick=()=>karaoke(true); $('kx').onclick=()=>karaoke(false);
$('mpp').onclick=$('pp').onclick; $('mnx').onclick=next;
