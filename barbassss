def unique(p):
    if not os.path.exists(p):
        return p
    b, e = os.path.splitext(p)
    i = 1
    while os.path.exists('%s (%d)%s' % (b, i, e)):
        i += 1
    return '%s (%d)%s' % (b, i, e)


