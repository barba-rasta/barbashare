                printf ' 📁 %s/ %s(%s)%s\n' "$(recortar "$(basename -- "$f")" 24)" "$C_D" "$(tamano_dir "$f")" "$C_0"
                [[ "$FOLDER_MODE" == "zip" ]] && dim "    (se descarga como .zip)"
            else
