flujo_web() {
    local src="${1:-}" dir
    titulo "🌐 PUBLICAR PÁGINA WEB"
    if [[ -z "$src" ]]; then
        warn "Elige la carpeta del sitio o su archivo index.html."
        dim "En el explorador, pulsa s dentro de la carpeta para elegirla."
        dim "Se servirá index.html y los recursos de esa carpeta, sin listado de archivos."
        echo
        SEL=()
        navegar "" || return 0
        if (( ${#SEL[@]} != 1 )); then
            err "Selecciona una sola carpeta o el archivo index.html."
            return 1
        fi
        src="${SEL[0]}"
    fi
    src="${src/#\~/$HOME}"
    if [[ -f "$src" ]]; then
        if [[ "$(basename -- "$src")" != "index.html" ]]; then
            err "El archivo elegido debe llamarse index.html."
            return 1
