#!/usr/bin/env bash
# ==========================================================
#  BARBASHARE  v3.5   (Termux / Linux / VPS)
#  ★ Herramienta creada por Jorge Barba ★
#
#  Comparte archivos o CARPETAS con un enlace público, con
#  reproductor multimedia web, y también RECIBE archivos.
#
#  Instalar (una sola vez):   bash barbashare --instalar
#  Después, en cualquier carpeta: barbashare
#
#  Uso:
#    barbashare                  -> menú principal
#    barbashare cancion.mp3      -> comparte ese archivo
#    barbashare MiCarpeta        -> comparte la carpeta
#    barbashare -z MiCarpeta     -> carpeta en un .zip
#    barbashare -p auto a.mp4    -> con contraseña
#    barbashare -t 30 -x 1 a.zip -> 30 min / 1 apertura
#    barbashare -r               -> recibir archivos
#    barbashare -m local a.mp4   -> solo en tu Wi-Fi
#
#  Métodos (-m): auto | cloudflared | pinggy | lhr | serveo
#                tuns | lt | local
# ==========================================================

VERSION="3.5"
AUTOR="Jorge Barba"

# ---------- Entorno ----------
IS_TERMUX=false
if [[ -n "${TERMUX_VERSION:-}" || -d /data/data/com.termux/files ]]; then
    IS_TERMUX=true
fi

# ---------- Colores (solo si hay terminal) ----------
if [[ -t 1 ]]; then
    C_R=$'\e[1;31m'; C_G=$'\e[1;32m'; C_Y=$'\e[1;33m'; C_B=$'\e[1;34m'
    C_C=$'\e[1;36m'; C_W=$'\e[1;37m'; C_D=$'\e[0;90m'; C_I=$'\e[3m'; C_0=$'\e[0m'
else
    C_R=""; C_G=""; C_Y=""; C_B=""; C_C=""; C_W=""; C_D=""; C_I=""; C_0=""
fi
BAR="$(printf '▬%.0s' {1..54})"
TRANS_DIR="$HOME/.config/barbashare"
TRANS_LANG_FILE="${BARBASHARE_LANG_FILE:-$TRANS_DIR/.idioma}"
TRANS_CACHE_FILE="${BARBASHARE_TRANS_CACHE:-$TRANS_DIR/.texto}"
TRANS_INSTALL_ATTEMPTED=false
TRANS_MISSING_NOTIFIED=false

trans() {
    local text="${1:-}" lang="" key cached translated encoded
    if [[ -z "$lang" && -r "$TRANS_LANG_FILE" ]]; then IFS= read -r lang < "$TRANS_LANG_FILE" || true; fi
    [[ -n "$lang" ]] || lang="es"
    if [[ "$lang" == "es" ]]; then printf '%s' "$text"; return 0; fi
    key=$(printf '%s\0%s' "$lang" "$text" | cksum | awk '{print $1 ":" $2}')
    if [[ -r "$TRANS_CACHE_FILE" ]]; then
        cached=$(awk -F '\t' -v k="$key" '$1==k {print $2; exit}' "$TRANS_CACHE_FILE")
        if [[ -n "$cached" ]]; then printf '%s' "$cached" | base64 -d 2>/dev/null && return 0; fi
    fi
    if ! type -P trans >/dev/null 2>&1; then
        if $IS_TERMUX && ! $TRANS_INSTALL_ATTEMPTED && command -v pkg >/dev/null 2>&1; then
            TRANS_INSTALL_ATTEMPTED=true
            pkg install -y translate-shell >/dev/null 2>&1 || true
        fi
    fi
    if ! type -P trans >/dev/null 2>&1; then
        if ! $TRANS_MISSING_NOTIFIED; then
            printf 'BarbaShare: instala translate-shell para traducir a %s; se mostrará el texto original mientras tanto.\n' "$lang" >&2
            TRANS_MISSING_NOTIFIED=true
        fi
        printf '%s' "$text"
        return 0
    fi
    translated=$(command trans -e bing -b "es:$lang" "$text" 2>/dev/null)
    if [[ -n "$translated" ]]; then
        encoded=$(printf '%s' "$translated" | base64 | tr -d '\r\n')
        mkdir -p "$TRANS_DIR" "$(dirname -- "$TRANS_CACHE_FILE")" 2>/dev/null
        printf '%s\t%s\n' "$key" "$encoded" >> "$TRANS_CACHE_FILE" 2>/dev/null
        printf '%s' "$translated"
    else
        printf '%s' "$text"
    fi
}
fun_trans() { trans "$@"; }
read() {
    if [[ "${1:-}" == "-rp" ]]; then
        local prompt="${2:-}"
        shift 2
        builtin read -rp "$(trans "$prompt")" "$@"
    else
        builtin read "$@"
    fi
}

bar()    { printf '%s%s%s\n' "$C_B" "$BAR" "$C_0"; }
ok()     { printf '%s✔ %s%s\n' "$C_G" "$(trans "$*")" "$C_0"; }
warn()   { printf '%s⚠ %s%s\n' "$C_Y" "$(trans "$*")" "$C_0"; }
err()    { printf '%s✘ %s%s\n' "$C_R" "$(trans "$*")" "$C_0"; }
info()   { printf '%s➜ %s%s\n' "$C_C" "$(trans "$*")" "$C_0"; }
dim()    { printf '%s%s%s\n' "$C_D" "$(trans "$*")" "$C_0"; }
titulo() {
    clear 2>/dev/null
    bar
    printf '%s[%s~%s]%s %s%s%s %s%sBARBASHARE%s\n' "$C_R" "$C_G" "$C_R" "$C_G" "$C_I" "$(trans "$*")" "$C_0" "$C_Y" "$C_I" "$C_0"
    bar
}
banner() {
    clear 2>/dev/null
    bar
    printf '%s[%s~%s]%s %s%s%s  %sv%s%s\n' "$C_R" "$C_G" "$C_R" "$C_G" "$C_I" "$(trans 'BARBASHARE')" "$C_0" "$C_D" "$VERSION" "$C_0"
    printf '%s  ★ %s %s ★%s\n' "$C_C" "$(trans 'Creado por')" "$AUTOR" "$C_0"
    bar
}
opcion() {
    local n
    printf -v n '%02d' "$1" 2>/dev/null || n="$1"
    printf ' %s[%s%s%s]%s➜%s %s%s\n' "$C_R" "$C_G" "$n" "$C_R" "$C_Y" "$C_C" "$(trans "$2")" "$C_0"
}

