menu_idioma() {
    local -a codes=(ar zh en fr de it ja hi pt ru tr sv da no fi nl el he ko th vi pl uk cs hu ro ms id fa es)
    local -a names=(Arabic Chinese English French German Italian Japanese Hindi Portuguese Russian Turkish Swedish Danish Norwegian Finnish Dutch Greek Hebrew Korean Thai Vietnamese Polish Ukrainian Czech Hungarian Romanian Malay Indonesian Persian Spanish)
    local r n rows columns row col idx current="es"
    [[ -r "$TRANS_LANG_FILE" ]] && IFS= read -r current < "$TRANS_LANG_FILE"
    titulo "🌐 CAMBIAR IDIOMA"
    dim "$(trans "Idioma actual: $current")"
    echo
    columns=3
    rows=$((( ${#codes[@]} + columns - 1 ) / columns))
    for ((row=0; row<rows; row++)); do
        for ((col=0; col<columns; col++)); do
            idx=$((row + col * rows))
            if (( idx < ${#codes[@]} )); then
                printf ' %s[%s%02d%s]%s➜ %s%-13s%s' "$C_R" "$C_G" "$((idx+1))" "$C_R" "$C_Y" "$C_C" "$(trans "${names[idx]}")" "$C_0"
            fi
        done
        printf '\n'
    done
    bar
    read -rp "Seleccione una opción (0 para volver): " r || return 0
    [[ "$r" == "0" || -z "$r" ]] && return 0
    if [[ ! "$r" =~ ^[0-9]+$ ]]; then warn "Opción no válida"; return 1; fi
    n=$((10#$r))
    if (( n < 1 || n > ${#codes[@]} )); then warn "Opción no válida"; return 1; fi
    mkdir -p "$TRANS_DIR" "$(dirname -- "$TRANS_LANG_FILE")" 2>/dev/null || { err "No pude crear la configuración del idioma"; return 1; }
    printf '%s\n' "${codes[n-1]}" > "$TRANS_LANG_FILE" || { err "No pude guardar el idioma"; return 1; }
    rm -f -- "$TRANS_CACHE_FILE"
    ok "$(trans "Idioma guardado: ${names[n-1]}")"
    if [[ "${codes[n-1]}" != "es" ]] && ! type -P trans >/dev/null 2>&1; then
        warn "Instala translate-shell para activar la traducción en este sistema."
    fi
    sleep 1
}

