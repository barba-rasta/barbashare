class H(SimpleHTTPRequestHandler):
    protocol_version = 'HTTP/1.1'          # conexiones persistentes (mucho más rápido por túnel)

    def setup(self):
        super().setup()
        try:
            self.connection.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
        except OSError:
            pass

    def auth(self):
        if not PASS:
            return True
        h = self.headers.get('Authorization', '')
        if h.startswith('Basic '):
            try:
                pw = base64.b64decode(h[6:]).decode('utf-8', 'replace').partition(':')[2]
                if hmac.compare_digest(pw.encode(), PASS.encode()):
                    return True
            except Exception:
                pass
        self.send_response(401)
        self.send_header('WWW-Authenticate', 'Basic realm="BarbaShare", charset="UTF-8"')
        self.send_header('Content-Length', '0')
        if self.command in ('PUT', 'POST'):
            self.send_header('Connection', 'close')
        self.end_headers()
        return False

    def do_GET(self):
        self.serve(False)

    def do_HEAD(self):
        self.serve(True)

    def send_json(self, obj, code=200):
        body = json.dumps(obj, ensure_ascii=False).encode('utf-8')
        self.send_response(code)
        self.send_header('Content-Type', 'application/json; charset=utf-8')
        self.send_header('Content-Length', str(len(body)))
        self.send_header('Cache-Control', 'no-store')
        self.end_headers()
        self.wfile.write(body)

    def api_ok(self):
        if self.headers.get('X-BS') == '1':
            return True
        self.send_json({'error': 'Petición no válida'}, 403)
        return False

    def do_POST(self):
        self.close_connection = True
        if MODE != 'tube':
            self.send_error(405, 'No permitido')
            return
        if not self.auth():
            return
        path = self.path.split('?', 1)[0]
        if path != '/api/start' or not self.api_ok():
            if path != '/api/start':
                self.send_error(404, 'No encontrado')
            return
        if YT is None:
            self.send_json({'error': 'yt-dlp no está instalado en este dispositivo'}, 500)
            return
        try:
            n = int(self.headers.get('Content-Length', '0'))
            if n < 0 or n > 4096:
                raise ValueError
            data = json.loads(self.rfile.read(n) or b'{}')
        except Exception:
            self.send_json({'error': 'Datos no válidos'}, 400)
            return
        url = normalize_source(str(data.get('url', '')))
        fmt = str(data.get('format_id', ''))
        presets = ('best', 'video1080', 'video720', 'video480', 'audio', 'audio_mp3', 'audio_m4a', 'audio_flac')
        if not url or (fmt not in presets and not FORMAT_ID_RE.fullmatch(fmt)):
            self.send_json({'error': 'Enlace o formato no válido'}, 400)
            return
        if fmt in ('audio_mp3', 'audio_m4a', 'audio_flac') and not FFMPEG:
            self.send_json({'error': 'FFmpeg es necesario para convertir audio a MP3, M4A o FLAC'}, 400)
            return
        jid = uuid.uuid4().hex[:10]
        with JOBS_LOCK:
            for k in list(JOBS)[:-50]:
                JOBS.pop(k, None)
            JOBS[jid] = {'status': 'queued', 'pct': 0, 'msg': ''}
        threading.Thread(target=run_job, args=(jid, url, fmt), daemon=True).start()
        self.close_connection = False
        self.send_json({'job': jid})

    def tube_get(self, path, head):
        q = urllib.parse.parse_qs(urllib.parse.urlsplit(self.path).query)
        if path == '/':
            body = (TUBE.replace('__AVISO__', html.escape(AVISO))
                    .replace('__FFMPEG__', 'true' if FFMPEG else 'false')
                    .replace('__CREDITO__', CREDITO).encode('utf-8'))
            self.send_response(200)
            self.send_header('Content-Type', 'text/html; charset=utf-8')
            self.send_header('Content-Length', str(len(body)))
            self.send_header('Cache-Control', 'no-store')
            self.end_headers()
            if not head:
                self.wfile.write(body)
            return
        if path.startswith('/api/'):
            if not self.api_ok():
                return
            if path == '/api/files':
                self.send_json({'files': list_library()})
                return
            if path == '/api/job':
                j = JOBS.get((q.get('id') or [''])[0])
                if not j:
                    self.send_json({'error': 'Descarga no encontrada'}, 404)
                    return
                self.send_json({'status': j['status'], 'pct': j.get('pct', 0),
                                'msg': j.get('msg', ''), 'file': j.get('file')})
                return
            if path in ('/api/search', '/api/info'):
                if YT is None:
                    self.send_json({'error': 'yt-dlp no está instalado en este dispositivo'}, 500)
                    return
                try:
                    if path == '/api/search':
                        self.send_json({'results': yt_search((q.get('q') or [''])[0])})
                    else:
                        url = normalize_source((q.get('url') or [''])[0])
                        if not url:
                            self.send_json({'error': 'Pega un enlace HTTP(S) compatible con yt-dlp'}, 400)
                        else:
                            self.send_json({'results': [yt_info(url)]})
                except subprocess.TimeoutExpired:
                    self.send_json({'error': 'yt-dlp tardó demasiado en responder'}, 504)
                except Exception:
                    self.send_json({'error': 'No se pudo consultar este sitio (comprueba el enlace, la conexión y la versión de yt-dlp)'}, 502)
                return
            self.send_json({'error': 'No encontrado'}, 404)
            return
        if path.startswith('/dl/'):
            name = urllib.parse.unquote(path[4:])
            fp = os.path.join(DEST, name)
            if (not name or '/' in name or '\\' in name or name.startswith('.') or '\x00' in name
                    or os.path.splitext(name)[1].lower() not in LIB_EXT
                    or not os.path.isfile(fp)
                    or not os.path.realpath(fp).startswith(os.path.realpath(DEST) + os.sep)):
                self.send_error(404, 'No encontrado')
                return
            self.send_file(fp, head, attach=('dl' in q))
            return
        self.send_error(404, 'No encontrado')

    def do_PUT(self):
        if MODE != 'recv':
            self.close_connection = True
            self.send_error(405, 'No permitido')
            return
        if not self.auth():
            return
        u = urllib.parse.urlsplit(self.path)
        if u.path != '/upload':
            self.send_error(404, 'No encontrado')
            return
        name = safe_name((urllib.parse.parse_qs(u.query).get('name') or ['archivo'])[0])
        try:
            n = int(self.headers.get('Content-Length', ''))
        except ValueError:
            self.send_error(411, 'Falta Content-Length')
            return
        os.makedirs(DEST, exist_ok=True)
        final = unique(os.path.join(DEST, name))
        tmp = final + '.part'
        try:
            with open(tmp, 'wb') as f:
                left = n
                while left > 0:
                    chunk = self.rfile.read(min(1 << 20, left))
                    if not chunk:
                        raise ConnectionError('corte')
                    f.write(chunk)
                    left -= len(chunk)
            os.replace(tmp, final)
        except Exception:
            try:
                os.remove(tmp)
            except OSError:
                pass
            self.send_error(500, 'No se pudo guardar')
            return
        sys.stderr.write('RECIBIDO %s\n' % os.path.basename(final))
        sys.stderr.flush()
        body = json.dumps({'ok': True, 'name': os.path.basename(final)}).encode()
        self.send_response(200)
        self.send_header('Content-Type', 'application/json')
        self.send_header('Content-Length', str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def serve_web(self, path, head):
        requested = urllib.parse.unquote(path)
        if not requested.startswith('/') or '\x00' in requested or '\\' in requested:
            self.send_error(404, 'No encontrado')
            return
        parts = [p for p in requested.split('/') if p]
        if any(p in ('.', '..') or p.startswith('.') for p in parts):
            self.send_error(404, 'No encontrado')
            return
        root = os.path.realpath(ROOT)

        def inside(candidate):
            try:
                return os.path.commonpath((root, candidate)) == root
            except ValueError:
                return False

        target = os.path.realpath(os.path.join(root, *(parts or ['index.html'])))
        if not inside(target):
            self.send_error(404, 'No encontrado')
            return
        if os.path.isdir(target):
            target = os.path.realpath(os.path.join(target, 'index.html'))
        if not os.path.isfile(target) and parts and not os.path.splitext(parts[-1])[1]:
            target = os.path.realpath(os.path.join(root, 'index.html'))
        if not inside(target) or not os.path.isfile(target):
            self.send_error(404, 'No encontrado')
            return
        self.send_file(target, head)
        if not head and requested in ('/', '/index.html'):
            sys.stderr.write('WEBVISITA %s\n' % self.client_address[0])
            sys.stderr.flush()

    def serve(self, head):
        if not self.auth():
            return
        path = self.path.split('?', 1)[0].split('#', 1)[0]
        if MODE == 'web':
            self.serve_web(path, head)
            return
        if MODE == 'tube':
            self.tube_get(path, head)
            return
        if MODE == 'recv':
            if path == '/':
                body = UPLOAD.replace('__CREDITO__', CREDITO).encode('utf-8')
                self.send_response(200)
                self.send_header('Content-Type', 'text/html; charset=utf-8')
                self.send_header('Content-Length', str(len(body)))
                self.send_header('Cache-Control', 'no-store')
                self.end_headers()
                if not head:
                    self.wfile.write(body)
            else:
                self.send_error(404, 'No encontrado')
            return
        if PLAYER and path == '/':
            body = page().encode('utf-8')
            self.send_response(200)
            self.send_header('Content-Type', 'text/html; charset=utf-8')
            self.send_header('Content-Length', str(len(body)))
            self.send_header('Cache-Control', 'no-store')
            self.end_headers()
            if not head:
                self.wfile.write(body)
            return
        fp = self.translate_path(self.path)
        if os.path.isdir(fp):
            self.close_connection = True
            if head:
                SimpleHTTPRequestHandler.do_HEAD(self)
            else:
                SimpleHTTPRequestHandler.do_GET(self)
            return
        if not os.path.isfile(fp):
            self.send_error(404, 'No encontrado')
            return
        self.send_file(fp, head)

    def guess_type(self, path):
        t = super().guess_type(path)
        if t.startswith('text/') and 'charset' not in t:
            t += '; charset=utf-8'
        return t

    def send_file(self, fp, head, attach=False):
        try:
            f = open(fp, 'rb')
        except OSError:
            self.send_error(404, 'No encontrado')
            return
        with f:
            size = os.fstat(f.fileno()).st_size
            start, end, code = 0, size - 1, 200
            rng = self.headers.get('Range')
            if rng:
                m = re.match(r'bytes=(\d*)-(\d*)$', rng.strip())
                if m and (m.group(1) or m.group(2)):
                    if m.group(1):
                        start = int(m.group(1))
                        if m.group(2):
                            end = min(int(m.group(2)), size - 1)
                    else:
                        start = max(size - int(m.group(2)), 0)
                    if start >= size or start > end:
                        self.send_response(416)
                        self.send_header('Content-Range', 'bytes */%d' % size)
                        self.send_header('Content-Length', '0')
                        self.end_headers()
                        return
                    code = 206
            length = end - start + 1 if size else 0
            self.send_response(code)
            self.send_header('Content-Type', self.guess_type(fp))
            self.send_header('Accept-Ranges', 'bytes')
            self.send_header('Content-Length', str(length))
            self.send_header('Cache-Control', 'private, max-age=3600')
            if attach:
                nm = os.path.basename(fp)
                self.send_header('Content-Disposition', "attachment; filename*=UTF-8''" + urllib.parse.quote(nm))
            if code == 206:
                self.send_header('Content-Range', 'bytes %d-%d/%d' % (start, end, size))
            self.end_headers()
            if head:
                return
            try:
                self.wfile.flush()
                try:
                    self.connection.sendfile(f, start, length)      # envío directo del kernel
                except (AttributeError, NotImplementedError, OSError) as e:
                    if isinstance(e, (BrokenPipeError, ConnectionResetError)):
                        raise
                    f.seek(start)
                    left = length
                    while left > 0:
                        chunk = f.read(min(262144, left))
                        if not chunk:
                            break
                        self.wfile.write(chunk)
                        left -= len(chunk)
            except (BrokenPipeError, ConnectionResetError, TimeoutError):
                self.close_connection = True


ThreadingHTTPServer.request_queue_size = 128
