            fi
        done
        echo
        if [[ "$PLAYER" == "1" ]]; then
            printf ' %s🎧 %s%s\n\n' "$C_G" "$(trans 'Enlace con reproductor:')" "$C_0"
        else
            printf ' %s🔗 %s%s\n\n' "$C_G" "$(trans 'Envía este enlace:')" "$C_0"
        fi
    fi
    printf '%s%s%s\n\n' "$C_C" "$url" "$C_0"
    if [[ -n "$direct" ]]; then
