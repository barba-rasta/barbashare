    echo "${1/#$HOME/$t}"
}

tamano() {
    local s t
    s=$(stat -c %s -- "$1" 2>/dev/null) || { echo "?"; return; }
    if   (( s < 1024 ));       then echo "${s} B"
    elif (( s < 1048576 ));    then echo "$(( s / 1024 )) KB"
    elif (( s < 1073741824 )); then t=$(( s * 10 / 1048576 ));    echo "$(( t / 10 )).$(( t % 10 )) MB"
    else                            t=$(( s * 10 / 1073741824 )); echo "$(( t / 10 )).$(( t % 10 )) GB"
    fi
}

tamano_dir() {
    local sz n
    sz=$(du -sh -- "$1" 2>/dev/null | cut -f1)
    n=$(find "$1" -type f 2>/dev/null | wc -l)
    echo "$(trans "${n} archivos, ${sz:-?}")"
}

