# ==========================================================
#  Túneles  (cada uno deja RE / NOMBRE y lanza el proceso)
# ==========================================================
asegurar_cloudflared() {
    command -v cloudflared >/dev/null 2>&1 && return 0
    if $IS_TERMUX; then
        instalar_pkg cloudflared cloudflared
        return $?
    fi
    local arch bin="$HOME/.local/bin"
    case "$(uname -m)" in
        x86_64)              arch="amd64" ;;
        aarch64|arm64)       arch="arm64" ;;
        armv7l|armv8l|arm*)  arch="arm"   ;;
        *) err "Arquitectura no soportada: $(uname -m)"; return 1 ;;
    esac
    command -v curl >/dev/null 2>&1 || instalar_pkg curl curl || return 1
    mkdir -p "$bin"
    info "Descargando cloudflared..."
    if curl -fsSL -o "$bin/cloudflared" \
        "https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-$arch"; then
        chmod +x "$bin/cloudflared"
        export PATH="$bin:$PATH"
        return 0
    fi
    err "No se pudo descargar cloudflared"
    return 1
}

lanzar_tunel() {
    local m="$1"
    : > "$TLOG"
    READY_RE=""
    case "$m" in
        cloudflared)
            NOMBRE="Cloudflare"
            RE='https://[a-z0-9-]+\.trycloudflare\.com'
            READY_RE='Registered tunnel connection'
            asegurar_cloudflared || return 1
            cloudflared tunnel --no-autoupdate --url "http://127.0.0.1:$PORT" \
                <&9 >"$TLOG" 2>&1 &
            ;;
        pinggy)
            NOMBRE="Pinggy"
            RE='https://[A-Za-z0-9.-]+\.pinggy\.(link|online|io)'
            instalar_pkg ssh openssh openssh-client || return 1
            ssh "${SSH_OPTS[@]}" -p 443 -R0:127.0.0.1:"$PORT" a.pinggy.io \
                <&9 >"$TLOG" 2>&1 &
            ;;
        lhr)
            NOMBRE="localhost.run"
            RE='https://[a-z0-9-]+\.lhr\.life'
            instalar_pkg ssh openssh openssh-client || return 1
            ssh "${SSH_OPTS[@]}" -R 80:127.0.0.1:"$PORT" nokey@localhost.run \
                <&9 >"$TLOG" 2>&1 &
            ;;
        serveo)
            NOMBRE="Serveo"
            RE='https://[a-z0-9-]+\.serveo(usercontent)?\.(net|com)'
            instalar_pkg ssh openssh openssh-client || return 1
            ssh "${SSH_OPTS[@]}" -R 80:127.0.0.1:"$PORT" serveo.net \
                <&9 >"$TLOG" 2>&1 &
            ;;
        tuns)
            NOMBRE="tuns.sh"
            RE='https://[a-z0-9-]+\.tuns\.sh'
            instalar_pkg ssh openssh openssh-client || return 1
            ssh "${SSH_OPTS[@]}" -R 80:127.0.0.1:"$PORT" tuns.sh \
                <&9 >"$TLOG" 2>&1 &
            ;;
        lt)
            NOMBRE="Localtunnel"
            RE='https://[a-z0-9-]+\.loca\.lt'
            instalar_pkg npx nodejs nodejs || return 1
            npx --yes localtunnel --port "$PORT" \
                <&9 >"$TLOG" 2>&1 &
            ;;
        *)
            err "Método desconocido: $m"
            return 1
            ;;
    esac
    TUNNEL_PID=$!
    return 0
}

esperar_url() {
    local i u
    URL_BASE=""
    for ((i = 1; i <= 45; i++)); do
        kill -0 "$TUNNEL_PID" 2>/dev/null || break
        u=$(limpiar_log "$TLOG" | grep -oE "$RE" \
            | grep -vE '^https://(api|dashboard|docs|www)\.' | head -n1)
        if [[ -n "$u" ]]; then URL_BASE="$u"; break; fi
        $QUIET || printf '\r   %s %ss ' "$(trans 'esperando enlace...')" "$i"
        sleep 1
    done
    $QUIET || printf '\r\033[K'
    [[ -n "$URL_BASE" ]] || return 1
    # Espera (máx. 12 s) a que el túnel esté realmente registrado
    if [[ -n "$READY_RE" ]]; then
        for ((i = 0; i < 12; i++)); do
            limpiar_log "$TLOG" | grep -qE "$READY_RE" && break
            sleep 1
        done
    fi
    return 0
}

