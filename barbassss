ID_RE = re.compile(r'^[A-Za-z0-9_-]{11}$')
FORMAT_ID_RE = re.compile(r'^[A-Za-z0-9_.-]{1,80}$')
LIB_EXT = {
    '.mp3', '.m4a', '.m4b', '.m4p', '.mp2', '.mpa', '.aac', '.ac3', '.aiff', '.alac',
