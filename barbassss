detener_tunel() {
    if [[ -n "$TUNNEL_PID" ]]; then
        kill "$TUNNEL_PID" 2>/dev/null
        wait "$TUNNEL_PID" 2>/dev/null
        TUNNEL_PID=""
    fi
}

parar_todo() {
    detener_tunel
    if [[ -n "$SERVER_PID" ]]; then
        kill "$SERVER_PID" 2>/dev/null
        wait "$SERVER_PID" 2>/dev/null
        SERVER_PID=""
    fi
    exec 9>&- 2>/dev/null
    if [[ -n "$TMPD" ]]; then
        rm -rf -- "$TMPD" "$TMPD.http.log" "$TMPD.tunnel.log" "$TMPD.srv.py"
        TMPD=""
    fi
}

fin() {
    parar_todo
    if $WAKE; then termux-wake-unlock 2>/dev/null; WAKE=false; fi
    printf '%s' "$C_0"
}

on_int() {
    if $HOLDING; then
        STOP=true
    else
        echo
        exit 130
    fi
}

trap on_int INT
trap 'exit 143' TERM
trap fin EXIT

