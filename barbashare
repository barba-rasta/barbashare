instalar_pkg() {   # comando  paquete_termux  [paquete_apt]
    local cmd="$1" pt="$2" pa="${3:-$2}" tmp
    command -v "$cmd" >/dev/null 2>&1 && return 0
    info "Instalando '$pt' (solo la primera vez)..."
    tmp=$(mktemp "${TMPDIR:-/tmp}/inst.XXXXXX")
    if $IS_TERMUX; then
        pkg install -y "$pt" >"$tmp" 2>&1
    elif command -v apt-get >/dev/null 2>&1; then
        if [[ $EUID -eq 0 ]]; then
            apt-get install -y "$pa" >"$tmp" 2>&1
        elif command -v sudo >/dev/null 2>&1; then
            sudo apt-get install -y "$pa" >"$tmp" 2>&1
        fi
    fi
    if command -v "$cmd" >/dev/null 2>&1; then
        rm -f "$tmp"
        return 0
    fi
    err "No se pudo instalar '$pt'."
    [[ -s "$tmp" ]] && tail -n 4 "$tmp"
    rm -f "$tmp"
    if $IS_TERMUX; then
        dim "Prueba a mano:  pkg update && pkg install $pt"
    else
        dim "Instálalo con tu gestor de paquetes (paquete: $pa)"
    fi
    return 1
}

detectar_python() {
    local c
    for c in python3 python; do
        if command -v "$c" >/dev/null 2>&1; then PY="$c"; return 0; fi
    done
    return 1
}

puerto_libre() {
    "$PY" - <<'EOF'
import socket
s = socket.socket()
s.bind(("127.0.0.1", 0))
print(s.getsockname()[1])
s.close()
EOF
}

# ==========================================================
#  Preparación
# ==========================================================
preparar_entorno() {
    if ! detectar_python; then
        instalar_pkg python3 python python3 || return 1
        detectar_python || { err "Python no disponible"; return 1; }
    fi
    # QR opcional: solo en Termux y una única vez
    if $IS_TERMUX && ! command -v qrencode >/dev/null 2>&1 \
        && [[ ! -e "$HOME/.compartir_qr_intentado" ]]; then
        info "Instalando generador de QR (opcional, solo esta vez)..."
        timeout 120 pkg install -y libqrencode >/dev/null 2>&1
        : > "$HOME/.compartir_qr_intentado"
    fi
    if $IS_TERMUX && command -v termux-wake-lock >/dev/null 2>&1; then
        termux-wake-lock 2>/dev/null && WAKE=true
    fi
    return 0
}

permiso_almacenamiento() {
    warn "Termux aún no tiene acceso a tus archivos"
    dim  "(Descargas, fotos, música...)"
    local r
    read -rp " ¿Dar acceso ahora? [S/n]: " r || exit 0
    [[ "${r,,}" == n* ]] && return 1
    info "Android te pedirá permiso: pulsa PERMITIR"
    termux-setup-storage
    local i
    for ((i = 0; i < 30; i++)); do
        [[ -d "$HOME/storage/shared" ]] && { ok "Acceso concedido"; sleep 1; return 0; }
        sleep 1
    done
    warn "No se concedió el permiso. Solo verás archivos de Termux."
    sleep 2
    return 1
}

preparar_carpeta() {
    local f base zipf
    NAMES=()
    TMPD=$(mktemp -d "${TMPDIR:-/tmp}/compartir.XXXXXX") || { err "No pude crear carpeta temporal"; return 1; }
    for f in "${SEL[@]}"; do
        base="$(basename -- "$f")"
        if [[ -d "$f" && "$FOLDER_MODE" == "zip" ]]; then
            zipf="$TMPD/$base.zip"
            info "Comprimiendo '$base' (puede tardar)..."
            if ! "$PY" -m zipfile -c "$zipf" "$f" >/dev/null 2>&1; then
                err "No se pudo crear el .zip de '$base'"
                return 1
            fi
            NAMES+=("$base.zip")
        elif [[ -d "$f" ]]; then
            ln -sfn -- "$f" "$TMPD/$base"
            NAMES+=("$base/")
        else
            ln -sf -- "$f" "$TMPD/$base"
            NAMES+=("$base")
        fi
    done
    # entrada estándar "infinita" para ssh (evita que se cierre al instante)
    local fifo="$TMPD.fifo"
    mkfifo "$fifo" && exec 9<>"$fifo"
    rm -f "$fifo"
    SLOG="$TMPD.http.log"
    TLOG="$TMPD.tunnel.log"
    return 0
}

