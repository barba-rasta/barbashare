YT = shutil.which('yt-dlp')
FFMPEG = shutil.which('ffmpeg')
JOBS = {}
JOBS_LOCK = threading.Lock()
JOBS_SEM = threading.Semaphore(2)
ID_RE = re.compile(r'^[A-Za-z0-9_-]{11}$')
URL_RE = re.compile(r'(?:youtube\.com/(?:watch\?(?:[^#]*&)?v=|shorts/|embed/|live/)|youtu\.be/)([A-Za-z0-9_-]{11})')
LIB_EXT = {'.mp3', '.m4a', '.opus', '.ogg', '.webm', '.mp4', '.mkv'}


def extract_id(text):
    text = (text or '').strip()
    if ID_RE.match(text):
        return text
    m = URL_RE.search(text)
    return m.group(1) if m else None


def card(vid, e):
    return {'id': vid, 'title': e.get('title') or vid,
            'ch': e.get('channel') or e.get('uploader') or '',
            'dur': e.get('duration'),
            'th': 'https://i.ytimg.com/vi/%s/mqdefault.jpg' % vid}


def yt_search(q):
    q = ' '.join((q or '').split())[:100]
    if not q:
        return []
    p = subprocess.run([YT, '--flat-playlist', '-J', '--no-warnings', '--socket-timeout', '15',
                        'ytsearch12:' + q], capture_output=True, text=True, timeout=75)
    data = json.loads(p.stdout or '{}')
    out = []
    for e in data.get('entries') or []:
        vid = e.get('id')
        if vid and ID_RE.match(vid):
            out.append(card(vid, e))
    return out


def yt_info(vid):
    p = subprocess.run([YT, '-J', '--no-playlist', '--no-warnings', '--socket-timeout', '15',
                        'https://www.youtube.com/watch?v=' + vid],
                       capture_output=True, text=True, timeout=75)
    return card(vid, json.loads(p.stdout or '{}'))


def run_job(jid, vid, fmt):
    j = JOBS[jid]
    with JOBS_SEM:
        j['status'] = 'running'
        os.makedirs(DEST, exist_ok=True)
        cmd = [YT, '--no-playlist', '--newline', '--progress', '--no-warnings', '--windows-filenames',
               '--match-filter', 'duration<=7200',
               '-o', os.path.join(DEST, '%(title).120B [%(id)s].%(ext)s'),
               '--print', 'after_move:filepath']
        if fmt == 'mp3':
            if FFMPEG:
                cmd += ['-x', '--audio-format', 'mp3', '--audio-quality', '0']
            else:
                cmd += ['-f', 'bestaudio[ext=m4a]/bestaudio']
        else:
            if FFMPEG:
                cmd += ['-f', 'bv*[height<=720][ext=mp4]+ba[ext=m4a]/b[height<=720][ext=mp4]/b[ext=mp4]/b',
                        '--merge-output-format', 'mp4']
            else:
                cmd += ['-f', 'b[ext=mp4]/b']
        cmd.append('https://www.youtube.com/watch?v=' + vid)
        last = ''
        try:
            proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                    text=True, bufsize=1, errors='replace')
            timer = threading.Timer(1800, proc.kill)
            timer.start()
            for line in proc.stdout:
                line = line.strip()
                if not line:
                    continue
                m = re.search(r'\[download\]\s+([\d.]+)%', line)
                if m:
                    j['pct'] = float(m.group(1))
                elif line.startswith('[ExtractAudio]') or line.startswith('[Merger]') or 'Post-process' in line:
                    j['msg'] = 'Convirtiendo...'
                    j['pct'] = 100.0
                elif os.path.isabs(line) and os.path.isfile(line):
                    j['file'] = os.path.basename(line)
                elif line.startswith('ERROR'):
                    last = line[:200]
            proc.wait()
            timer.cancel()
        except Exception as ex:
            last = str(ex)[:200]
            proc = None
        if j.get('file') and proc is not None and proc.returncode == 0:
            j['status'] = 'done'
            j['pct'] = 100.0
            sys.stderr.write('DESCARGADO %s\n' % j['file'])
            sys.stderr.flush()
        else:
            j['status'] = 'error'
            j['msg'] = last or 'No se pudo descargar (¿privado, de más de 2 h o sin conexión?)'


def list_library():
    out = []
    try:
        for n in os.listdir(DEST):
            fp = os.path.join(DEST, n)
            if n.startswith('.') or not os.path.isfile(fp):
                continue
            if os.path.splitext(n)[1].lower() in LIB_EXT:
                st = os.stat(fp)
                out.append({'n': n, 's': st.st_size, 't': st.st_mtime})
    except OSError:
        pass
    out.sort(key=lambda x: -x['t'])
    return out[:200]


