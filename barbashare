comprobar_url() {   # url  texto_esperado
    "$PY" - "$1" "$2" <<'EOF'
import sys, urllib.request
try:
    req = urllib.request.Request(sys.argv[1], headers={
        "User-Agent": "Mozilla/5.0", "bypass-tunnel-reminder": "1"})
    body = urllib.request.urlopen(req, timeout=20).read(300).decode("utf-8", "replace")
    sys.exit(0 if sys.argv[2] in body else 2)
except Exception:
    sys.exit(1)
EOF
}

probar_servidores() {
    local m t0 dt i res tok PT buenos=() nombres=() orden
    QUIET=true; MODO="share"; METODO="auto"
    local old_off=$PLAYER_OFF; PLAYER_OFF=true
    titulo "🧪 PRUEBA DE SERVIDORES"
    dim " Prueba cada servidor en tu conexión."
    dim " Puede tardar unos minutos. No cierres Termux."
    echo
    PT=$(mktemp -d "${TMPDIR:-/tmp}/probe.XXXXXX")
    tok="barbashare-ok-$RANDOM$RANDOM"
    printf '%s' "$tok" > "$PT/prueba.txt"
    SEL=("$PT/prueba.txt")
    preparar_carpeta || { rm -rf "$PT"; QUIET=false; PLAYER_OFF=$old_off; return 1; }
    if ! iniciar_servidor; then
        parar_todo; rm -rf "$PT"; QUIET=false; PLAYER_OFF=$old_off; return 1
    fi
    for m in cloudflared pinggy lhr serveo tuns lt; do
        t0=$SECONDS
        if ! lanzar_tunel "$m"; then
            printf ' %s✘%s %-14s no se pudo preparar\n' "$C_R" "$C_0" "$m"
            continue
        fi
        printf ' ⏳ %s...' "$NOMBRE"
        res="no dio enlace"
        if esperar_url; then
            res="el enlace no responde"
            for i in 1 2 3 4 5 6; do
                if comprobar_url "$URL_BASE/prueba.txt" "$tok"; then res="ok"; break; fi
                sleep 3
            done
        fi
        dt=$(( SECONDS - t0 ))
        printf '\r\033[K'
        if [[ "$res" == "ok" ]]; then
            printf ' %s✔%s %-14s funciona (%ss)\n' "$C_G" "$C_0" "$NOMBRE" "$dt"
            buenos+=("$dt $m"); nombres+=("$NOMBRE")
        else
            printf ' %s✘%s %-14s %s\n' "$C_R" "$C_0" "$NOMBRE" "$res"
        fi
        detener_tunel
    done
    parar_todo
    rm -rf "$PT"
    echo
    bar
    if (( ${#buenos[@]} )); then
        orden=$(printf '%s\n' "${buenos[@]}" | sort -n | awk '{print $2}' | tr '\n' ' ')
        echo "$orden" > "$ORDEN_FILE"
        ok "Funcionan ${#buenos[@]} de 6: ${nombres[*]}"
        dim " El modo automático los usará primero."
    else
        rm -f "$ORDEN_FILE"
        err "Ningún servidor funcionó ahora mismo."
        dim " Revisa tu internet o usa el modo Wi-Fi: -m local"
    fi
    dim " Prueba hecha $(date +%H:%M) · BarbaShare by $AUTOR"
    bar
    QUIET=false; PLAYER_OFF=$old_off
}

instalar_ytdlp() {
    local marca="$HOME/.barbashare_youtube_paquetes_v1"
    # pip --user instala aquí: conservar el PATH también al omitir la revisión.
    case ":$PATH:" in
        *":$HOME/.local/bin:"*) ;;
        *) export PATH="$HOME/.local/bin:$PATH" ;;
    esac
    # Una sola comprobación, incluso al cerrar y volver a abrir BarbaShare.
    [[ "${YOUTUBE_PAQUETES_REVISADOS:-}" == "1" || -f "$marca" ]] && return 0
    if ! command -v yt-dlp >/dev/null 2>&1; then
        if $IS_TERMUX; then
            instalar_pkg yt-dlp yt-dlp || return 1
        else
            info "Instalando yt-dlp..."
            "$PY" -m pip install --user -U yt-dlp >/dev/null 2>&1 \
                || "$PY" -m pip install --user --break-system-packages -U yt-dlp >/dev/null 2>&1
            export PATH="$HOME/.local/bin:$PATH"
            if ! command -v yt-dlp >/dev/null 2>&1; then
                err "No se pudo instalar yt-dlp."
                dim "Prueba:  pip install --user -U yt-dlp"
                return 1
            fi
        fi
    fi
    if ! command -v ffmpeg >/dev/null 2>&1; then
        info "Instalando ffmpeg (para MP3 y video HD)..."
        instalar_pkg ffmpeg ffmpeg >/dev/null 2>&1 \
            || warn "Sin ffmpeg: el audio se guardará como .m4a"
    fi
    # ffmpeg es opcional: no repetir su instalación si ya se intentó.
    YOUTUBE_PAQUETES_REVISADOS=1
    if ! (umask 077; : > "$marca") 2>/dev/null; then
        warn "No se pudo guardar la comprobación; se recordará solo durante esta ejecución."
    fi
    return 0
}

actualizar_ytdlp() {
    info "Actualizando yt-dlp (YouTube cambia a menudo)..."
    if $IS_TERMUX; then
        pkg upgrade -y yt-dlp
    else
        "$PY" -m pip install --user -U yt-dlp || "$PY" -m pip install --user --break-system-packages -U yt-dlp
    fi
    command -v yt-dlp >/dev/null 2>&1 && yt-dlp --version
}

