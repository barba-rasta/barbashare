# ==========================================================
#  Limpieza y señales
# ==========================================================
detener_tunel() {
    if [[ -n "$TUNNEL_PID" ]]; then
        kill "$TUNNEL_PID" 2>/dev/null
        wait "$TUNNEL_PID" 2>/dev/null
        TUNNEL_PID=""
    fi
}

parar_todo() {
    detener_tunel
    if [[ -n "$SERVER_PID" ]]; then
        kill "$SERVER_PID" 2>/dev/null
        wait "$SERVER_PID" 2>/dev/null
        SERVER_PID=""
    fi
    exec 9>&- 2>/dev/null
    if [[ -n "$TMPD" ]]; then
        rm -rf -- "$TMPD" "$TMPD.http.log" "$TMPD.tunnel.log" "$TMPD.srv.py"
        TMPD=""
    fi
}

fin() {
    parar_todo
    if $WAKE; then termux-wake-unlock 2>/dev/null; WAKE=false; fi
    printf '%s' "$C_0"
}

on_int() {
    if $HOLDING; then
        STOP=true
    else
        echo
        exit 130
    fi
}

trap on_int INT
trap 'exit 143' TERM
trap fin EXIT

# ==========================================================
#  Utilidades
# ==========================================================
short() {
    local t='~'
    echo "${1/#$HOME/$t}"
}

tamano() {
    local s t
    s=$(stat -c %s -- "$1" 2>/dev/null) || { echo "?"; return; }
    if   (( s < 1024 ));       then echo "${s} B"
    elif (( s < 1048576 ));    then echo "$(( s / 1024 )) KB"
    elif (( s < 1073741824 )); then t=$(( s * 10 / 1048576 ));    echo "$(( t / 10 )).$(( t % 10 )) MB"
    else                            t=$(( s * 10 / 1073741824 )); echo "$(( t / 10 )).$(( t % 10 )) GB"
    fi
}

tamano_dir() {
    local sz n
    sz=$(du -sh -- "$1" 2>/dev/null | cut -f1)
    n=$(find "$1" -type f 2>/dev/null | wc -l)
    echo "${n} archivos, ${sz:-?}"
}

icono() {
    case "${1,,}" in
        *.mp3|*.wav|*.m4a|*.ogg|*.flac|*.aac|*.opus) echo "🎵" ;;
        *.mp4|*.mkv|*.webm|*.mov|*.avi|*.3gp)        echo "🎬" ;;
        *.jpg|*.jpeg|*.png|*.gif|*.webp|*.bmp)       echo "🖼" ;;
        *.pdf)                                        echo "📕" ;;
        *.apk)                                        echo "📦" ;;
        *.zip|*.rar|*.7z|*.tar|*.gz|*.xz)            echo "🗜" ;;
        *)                                            echo "📄" ;;
    esac
}

