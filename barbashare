instalar_comando() {
    local dest src
    if $IS_TERMUX; then dest="${PREFIX:-/data/data/com.termux/files/usr}/bin"
    elif [[ -w /usr/local/bin ]]; then dest="/usr/local/bin"
    else dest="$HOME/.local/bin"; fi
    src="$(readlink -f -- "$0")"
    mkdir -p "$dest" || { err "No pude crear $dest"; return 1; }
    cp -- "$src" "$dest/barbashare" && chmod +x "$dest/barbashare" \
        || { err "No pude copiar el script a $dest"; return 1; }
    ok "Instalado en $dest"
    echo " Ahora escribe en cualquier carpeta:"
    printf '   %sbarbashare%s\n' "$C_C" "$C_0"
    case ":$PATH:" in
        *":$dest:"*) ;;
        *) warn "Añade $dest a tu PATH para que funcione." ;;
    esac
}

desinstalar_comando() {
    local d f n=0
    for d in "${PREFIX:-/data/data/com.termux/files/usr}/bin" /usr/local/bin "$HOME/.local/bin"; do
        for f in barbashare barba-share; do
            [[ -e "$d/$f" || -L "$d/$f" ]] && rm -f -- "$d/$f" && { ok "Borrado $d/$f"; ((n++)); }
        done
    done
    (( n )) || warn "No encontré nada instalado."
}

