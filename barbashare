def safe_name(n):
    n = os.path.basename(n.replace('\\', '/'))
    n = re.sub(r'[\x00-\x1f<>:"|?*]', '_', n).strip().lstrip('.')
    return n[:150] or 'archivo'


def unique(p):
    if not os.path.exists(p):
        return p
    b, e = os.path.splitext(p)
    i = 1
    while os.path.exists('%s (%d)%s' % (b, i, e)):
        i += 1
    return '%s (%d)%s' % (b, i, e)


