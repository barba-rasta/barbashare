#!/usr/bin/env bash
# ==========================================================
#  BARBASHARE  v3.1   (Termux / Linux / VPS)
#  ★ Herramienta creada por Jorge Barba ★
#
#  Comparte archivos o CARPETAS con un enlace público, con
#  reproductor multimedia web, y también RECIBE archivos.
#
#  Instalar (una sola vez):   bash barbashare --instalar
#  Después, en cualquier carpeta: barbashare
#
#  Uso:
#    barbashare                  -> menú principal
#    barbashare cancion.mp3      -> comparte ese archivo
#    barbashare MiCarpeta        -> comparte la carpeta
#    barbashare -z MiCarpeta     -> carpeta en un .zip
#    barbashare -p auto a.mp4    -> con contraseña
#    barbashare -t 30 -x 1 a.zip -> 30 min / 1 apertura
#    barbashare -r               -> recibir archivos
#    barbashare -m local a.mp4   -> solo en tu Wi-Fi
#
#  Métodos (-m): auto | cloudflared | pinggy | lhr | serveo
#                tuns | lt | local
# ==========================================================

VERSION="3.1"
AUTOR="Jorge Barba"

# ---------- Entorno ----------
IS_TERMUX=false
if [[ -n "${TERMUX_VERSION:-}" || -d /data/data/com.termux/files ]]; then
    IS_TERMUX=true
fi

# ---------- Colores (solo si hay terminal) ----------
if [[ -t 1 ]]; then
    C_R=$'\e[1;31m'; C_G=$'\e[1;32m'; C_Y=$'\e[1;33m'; C_B=$'\e[1;34m'
    C_C=$'\e[1;36m'; C_W=$'\e[1;37m'; C_D=$'\e[0;90m';  C_0=$'\e[0m'
else
    C_R=""; C_G=""; C_Y=""; C_B=""; C_C=""; C_W=""; C_D=""; C_0=""
fi
BAR="$(printf '═%.0s' {1..40})"

bar()    { printf '%s%s%s\n' "$C_B" "$BAR" "$C_0"; }
ok()     { printf '%s✔ %s%s\n' "$C_G" "$*" "$C_0"; }
warn()   { printf '%s⚠ %s%s\n' "$C_Y" "$*" "$C_0"; }
err()    { printf '%s✘ %s%s\n' "$C_R" "$*" "$C_0"; }
info()   { printf '%s➜ %s%s\n' "$C_C" "$*" "$C_0"; }
dim()    { printf '%s%s%s\n' "$C_D" "$*" "$C_0"; }
titulo() { clear 2>/dev/null; bar; printf '%s %s%s\n' "$C_W" "$*" "$C_0"; bar; }
banner() {
    clear 2>/dev/null
    bar
    printf '%s  📡 BARBASHARE%s  %sv%s%s\n' "$C_W" "$C_0" "$C_D" "$VERSION" "$C_0"
    printf '%s  ★ Creado por %s ★%s\n' "$C_C" "$AUTOR" "$C_0"
    bar
}
opcion() { printf ' %s[%s]%s %s\n' "$C_G" "$1" "$C_0" "$2"; }

