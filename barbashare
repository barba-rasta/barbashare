        else
            printf ' %s🔗 Abre este enlace para buscar y descargar:%s\n\n' "$C_G" "$C_0"
        fi
    elif [[ "$MODO" == "recv" ]]; then
        titulo "📥 LISTO PARA RECIBIR  ($NOMBRE)"
        printf ' 📂 Se guardan en:\n    %s\n\n' "$(short "$DEST_RECV")"
        printf ' %s🔗 Pásale este enlace a quien te envía:%s\n\n' "$C_G" "$C_0"
    else
