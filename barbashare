compartir() {
    local m lista conectado=false url nombre ip direct=""
    MODO="${1:-share}"
    if [[ "$MODO" != "share" ]]; then
        SEL=(); NAMES=()
    else
        elegir_modo_carpeta
    fi
    preparar_carpeta || { parar_todo; return 1; }
    if ! iniciar_servidor; then
        parar_todo
        read -rp " ENTER para continuar..." _
        return 1
    fi

    titulo "🚀 CREANDO ENLACE"
    if [[ "$METODO" == "self" ]]; then
        NOMBRE="Este dispositivo"
        URL_BASE="http://127.0.0.1:$PORT"
        TUNNEL_PID=""
        conectado=true
    elif [[ "$METODO" == "local" ]]; then
        ip=$(ip_local)
        if [[ -z "$ip" ]]; then
            err "No encontré tu IP de Wi-Fi. ¿Estás conectado a una red?"
        else
            NOMBRE="Red local"
            URL_BASE="http://$ip:$PORT"
            TUNNEL_PID=""
            conectado=true
        fi
    else
        case "$METODO" in
            auto|"") lista=($(orden_metodos)) ;;
            *)       lista=("$METODO") ;;
        esac
        for m in "${lista[@]}"; do
            if lanzar_tunel "$m"; then
                info "Conectando con $NOMBRE..."
                if esperar_url; then
                    conectado=true
                    break
                fi
                warn "$NOMBRE no respondió"
                [[ -s "$TLOG" ]] && limpiar_log "$TLOG" | grep -v '^\s*$' | tail -n 3
                detener_tunel
            fi
        done
    fi

    if ! $conectado; then
        err "No se pudo crear el enlace."
        dim "Revisa tu conexión o prueba otro método (o 'Red local')."
        parar_todo
        read -rp " ENTER para continuar..." _
        return 1
    fi

    if [[ "$MODO" != "share" ]]; then
        url="$URL_BASE/"
    else
        if (( ${#NAMES[@]} == 1 )); then
            nombre="${NAMES[0]}"
            url="$URL_BASE/$(urlenc "${nombre%/}")"
            [[ "$nombre" == */ ]] && url="$url/"
        else
            url="$URL_BASE/"
        fi
        if [[ "$PLAYER" == "1" ]]; then
            [[ "$url" != "$URL_BASE/" && "$nombre" != */ ]] && direct="$url"
            url="$URL_BASE/"
        fi
    fi

    mostrar_enlace "$url" "$direct"
    if [[ "$MODO" == "tube" && "$METODO" == "self" ]] && command -v termux-open-url >/dev/null 2>&1; then
        timeout 5 termux-open-url "$url" >/dev/null 2>&1 &
    fi
    mantener
    parar_todo
    echo
    if [[ "$MODO" == "recv" ]]; then
        ok "Dejaste de recibir. El enlace ya no funciona."
    elif [[ "$MODO" == "tube" ]]; then
        ok "Cerraste el panel de YouTube."
    else
        ok "Dejaste de compartir. El enlace ya no funciona."
    fi
    MODO="share"
    return 0
}

