        for f in "${SEL[@]}"; do
            if [[ -d "$f" ]]; then
                printf ' 📁 %s/ %s(%s)%s\n' "$(recortar "$(basename -- "$f")" 24)" "$C_D" "$(tamano_dir "$f")" "$C_0"
                [[ "$FOLDER_MODE" == "zip" ]] && dim "    (se descarga como .zip)"
            else
                printf ' %s %s %s(%s)%s\n' "$(icono "$f")" "$(recortar "$(basename -- "$f")" 30)" "$C_D" "$(tamano "$f")" "$C_0"
            fi
        done
        echo
        if [[ "$PLAYER" == "1" ]]; then
            printf ' %s🎧 Enlace con reproductor:%s\n\n' "$C_G" "$C_0"
        else
            printf ' %s🔗 Envía este enlace:%s\n\n' "$C_G" "$C_0"
        fi
    fi
    printf '%s%s%s\n\n' "$C_C" "$url" "$C_0"
    if [[ -n "$direct" ]]; then
        printf ' %s⬇ Descarga directa:%s\n\n' "$C_G" "$C_0"
        printf '%s%s%s\n\n' "$C_C" "$direct" "$C_0"
    fi
    if [[ -n "$PASSWORD" ]]; then
        printf ' %s🔑 Contraseña:%s %s%s%s\n' "$C_Y" "$C_0" "$C_W" "$PASSWORD" "$C_0"
        dim "    (usuario: el que sea · envíala aparte)"
    fi
    (( EXPIRA_MIN > 0 )) && printf ' %s⏳ Se cierra solo en %s min%s\n' "$C_Y" "$EXPIRA_MIN" "$C_0"
    (( MAX_ACCESOS > 0 )) && printf ' %s🎯 Se cierra tras %s apertura(s)%s\n' "$C_Y" "$MAX_ACCESOS" "$C_0"
    bar
    if command -v termux-clipboard-set >/dev/null 2>&1; then
        if printf '%s' "$url" | timeout 3 termux-clipboard-set 2>/dev/null; then
            ok "Enlace copiado al portapapeles"
        fi
    fi
    if command -v qrencode >/dev/null 2>&1; then
        qrencode -t ANSIUTF8 -m 1 "$url" 2>/dev/null
    fi
    if [[ "$METODO" == "local" ]]; then
        warn "Solo funciona en tu mismo Wi-Fi/hotspot."
    elif [[ "$MODO" == "tube" ]]; then
        dim " Quien tenga el enlace usa tu conexión y tu espacio."
        dim " Solo contenido tuyo o con permiso del autor."
    elif [[ "$MODO" == "recv" ]]; then
        dim " Cualquiera con el enlace puede enviarte archivos."
    else
        dim " Cualquiera con el enlace puede descargar."
    fi
    if $IS_TERMUX; then
        dim " Mantén Termux abierto (ya evita dormirse)."
        warn "Para parar: Volumen↓ + C   (o CTRL + C)"
    else
        warn "Para parar: Ctrl + C"
    fi
    dim " BarbaShare v$VERSION · by $AUTOR"
    bar
}

mantener() {
    local n n0=0 r r0=0 limite=0 nuevo pat
    HOLDING=true
    STOP=false
    (( EXPIRA_MIN > 0 )) && limite=$(( SECONDS + EXPIRA_MIN * 60 ))
    while ! $STOP; do
        if [[ -n "$TUNNEL_PID" ]] && ! kill -0 "$TUNNEL_PID" 2>/dev/null; then
            warn "El túnel se cerró."
            break
        fi
        if ! kill -0 "$SERVER_PID" 2>/dev/null; then
            warn "El servidor local se detuvo."
            break
        fi
        if (( limite > 0 && SECONDS >= limite )); then
            warn "⏳ Se cumplió el tiempo ($EXPIRA_MIN min)."
            break
        fi
        if [[ "$MODO" == "recv" || "$MODO" == "tube" ]]; then
            pat="RECIBIDO"; [[ "$MODO" == "tube" ]] && pat="DESCARGADO"
            r=$(grep -c "^$pat " "$SLOG" 2>/dev/null)
            if (( r > r0 )); then
                while IFS= read -r nuevo; do
                    if [[ "$MODO" == "tube" ]]; then
                        ok "⬇ Descargado: ${nuevo#"$pat "} $(date +%H:%M:%S)"
                    else
                        ok "📥 Recibido: ${nuevo#"$pat "} $(date +%H:%M:%S)"
                    fi
                    avisar "${nuevo#"$pat "}"
                done < <(grep "^$pat " "$SLOG" | tail -n +$(( r0 + 1 )))
                r0=$r
            fi
        else
            n=$(descargas)
            if (( n > n0 )); then
                ok "👀 Alguien abrió un archivo ($n) $(date +%H:%M:%S)"
                avisar "Alguien abrió tu enlace ($n)"
                n0=$n
            fi
            if (( MAX_ACCESOS > 0 && n >= MAX_ACCESOS )); then
                warn "🎯 Límite de aperturas alcanzado."
                sleep 2
                break
            fi
        fi
        sleep 2
    done
    HOLDING=false
}

