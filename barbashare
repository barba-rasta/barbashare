#!/usr/bin/env python3
# Servidor local: archivos con soporte Range (adelantar/retroceder)
# + reproductor multimedia web en "/" cuando PLAYER=1.
import base64, functools, hmac, html, json, mimetypes, os, re, shutil, socket, subprocess, sys, threading, time, urllib.parse, uuid
from http.server import ThreadingHTTPServer, SimpleHTTPRequestHandler

PORT = int(sys.argv[1])
ROOT = os.path.abspath(sys.argv[2])
PLAYER = sys.argv[3] == "1"
BIND = sys.argv[4] if len(sys.argv) > 4 else "127.0.0.1"
MODE = sys.argv[5] if len(sys.argv) > 5 else "share"       # share | recv | tube
DEST = os.path.abspath(sys.argv[6]) if len(sys.argv) > 6 else ROOT
PASS = os.environ.get("COMPARTIR_PASS", "")
CREDITO = '<footer class="cr">Hecho con ♥ usando <b>BarbaShare</b><br>Herramienta creada por <b>Jorge Barba</b></footer>'

for ext, mt in (('.mp3', 'audio/mpeg'), ('.m4a', 'audio/mp4'), ('.flac', 'audio/flac'),
                ('.opus', 'audio/ogg'), ('.aac', 'audio/aac'), ('.wav', 'audio/wav'),
                ('.mkv', 'video/x-matroska'), ('.mp4', 'video/mp4'), ('.webm', 'video/webm'),
                ('.mov', 'video/quicktime'), ('.3gp', 'video/3gpp'),
                ('.lrc', 'text/plain'), ('.vtt', 'text/vtt'), ('.srt', 'text/plain')):
    mimetypes.add_type(mt, ext)

EXT_A = {'.mp3', '.wav', '.m4a', '.ogg', '.oga', '.flac', '.aac', '.opus', '.weba'}
EXT_V = {'.mp4', '.webm', '.mkv', '.mov', '.m4v', '.3gp', '.ogv'}
EXT_I = {'.jpg', '.jpeg', '.png', '.gif', '.webp', '.bmp', '.svg'}
EXT_L = ['.lrc', '.vtt', '.srt', '.txt']          # letras / subtítulos (por prioridad)
COVER_NAMES = {'cover', 'folder', 'front', 'portada', 'album', 'artwork'}


def natkey(s):
    return [int(t) if t.isdigit() else t.lower() for t in re.split(r'(\d+)', s)]


def quote(parts):
    return '/' + '/'.join(urllib.parse.quote(x) for x in parts)


def scan():
    raw, seen = [], set()
    for dp, dn, fn in os.walk(ROOT, followlinks=True):
        rp = os.path.realpath(dp)
        depth = dp[len(ROOT):].count(os.sep)
        if rp in seen or depth > 8:
            dn[:] = []
            continue
        seen.add(rp)
        dn[:] = [d for d in dn if not d.startswith('.')]
        for f in fn:
            if f.startswith('.'):
                continue
            full = os.path.join(dp, f)
            try:
                size = os.path.getsize(full)
            except OSError:
                continue
            rel = os.path.relpath(full, ROOT)
            stem, ext = os.path.splitext(f)
            ext = ext.lower()
            raw.append({'dir': os.path.dirname(rel), 'f': f, 'stem': stem, 'ext': ext,
                        'rel': rel, 'size': size})

    media = {}                    # (dir, stem) -> item
    items = []
    for r in raw:
        k = 'a' if r['ext'] in EXT_A else 'v' if r['ext'] in EXT_V else None
        if k:
            parts = r['rel'].split(os.sep)
            it = {'k': k, 'n': r['stem'], 'b': r['f'], 'p': '/'.join(parts[:-1]),
                  'u': quote(parts), 's': r['size'], '_r': r['rel']}
            media[(r['dir'], r['stem'].lower())] = it
            items.append(it)

    audio_dirs = {}
    for it in items:
        if it['k'] == 'a':
            audio_dirs.setdefault(os.path.dirname(it['_r']), []).append(it)

    used = set()
    for r in raw:
        key = (r['dir'], r['stem'].lower())
        # letras / subtítulos con el mismo nombre
        if r['ext'] in EXT_L and key in media:
            it = media[key]
            cur = it.get('lx')
            if cur is None or EXT_L.index(r['ext']) < EXT_L.index(cur):
                it['lx'] = r['ext']
                it['l'] = quote(r['rel'].split(os.sep))
            used.add(r['rel'])
        # portadas
        if r['ext'] in EXT_I:
            hit = False
            if key in media and media[key]['k'] == 'a':
                media[key]['c'] = quote(r['rel'].split(os.sep))
                hit = True
            elif r['stem'].lower() in COVER_NAMES and r['dir'] in audio_dirs:
                for it in audio_dirs[r['dir']]:
                    it.setdefault('c', quote(r['rel'].split(os.sep)))
                hit = True
            if hit:
                used.add(r['rel'])

    for r in raw:
        if r['rel'] in used or r['ext'] in EXT_A or r['ext'] in EXT_V:
            continue
        parts = r['rel'].split(os.sep)
        k = 'i' if r['ext'] in EXT_I else 'o'
        items.append({'k': k, 'n': r['stem'] if k == 'i' else r['f'], 'b': r['f'],
                      'p': '/'.join(parts[:-1]), 'u': quote(parts), 's': r['size'],
                      '_r': r['rel']})

    items.sort(key=lambda x: natkey(x['_r']))
    for x in items:
        del x['_r']
    return items


def title():
    top = [e for e in os.listdir(ROOT) if not e.startswith('.')]
    if len(top) == 1:
        t = top[0]
        return os.path.splitext(t)[0] if os.path.isfile(os.path.join(ROOT, t)) else t
    return 'Archivos compartidos'


