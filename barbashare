# Devuelve: 0 = carpeta elegida en $CHOSEN | 3 = archivo elegido en $SEL | 1 = salir
menu_carpetas() {
    local d i r p cand=()
    if $IS_TERMUX; then
        [[ -d "$HOME/storage/shared" ]] || permiso_almacenamiento
        for d in downloads dcim pictures movies music shared; do
            [[ -d "$HOME/storage/$d" ]] && cand+=("$HOME/storage/$d")
        done
    else
        for d in Downloads Descargas Documents Documentos Pictures Imágenes Music Música Videos Desktop; do
            [[ -d "$HOME/$d" ]] && cand+=("$HOME/$d")
        done
    fi
    cand+=("$HOME")
    [[ "$PWD" != "$HOME" ]] && cand+=("$PWD")

    while true; do
        titulo "📂 ¿DE QUÉ CARPETA?"
        i=0
        for d in "${cand[@]}"; do
            ((i++))
            opcion "$i" "$(nombre_carpeta "$d")"
        done
        echo
        dim " r = escribir una ruta  ·  q = salir"
        read -rp " ➜ " r || return 1
        case "${r,,}" in
            q) return 1 ;;
            r)
                read -rp " Ruta: " p || return 1
                p="${p/#\~/$HOME}"
                if [[ -d "$p" ]]; then CHOSEN="$(readlink -f -- "$p")"; return 0; fi
                if [[ -f "$p" ]]; then SEL=("$(readlink -f -- "$p")"); return 3; fi
                warn "Esa ruta no existe"; sleep 1
                ;;
            *)
                if [[ "$r" =~ ^[0-9]+$ ]]; then
                    r=$((10#$r))
                    if (( r >= 1 && r <= ${#cand[@]} )); then
                        CHOSEN="${cand[r-1]}"
                        return 0
                    fi
                fi
                warn "Opción no válida"; sleep 1
                ;;
        esac
    done
}

# Devuelve 0 con $SEL lleno, o 1 si el usuario sale.
navegar() {
    local dir="$1" rc
    while true; do
        if [[ -z "$dir" ]]; then
            menu_carpetas; rc=$?
            case $rc in
                0) dir="$CHOSEN" ;;
                3) return 0 ;;
                *) return 1 ;;
            esac
        fi

        local subs=() files=() ent=() kind=() e i=0 ans tok p bad=false
        while IFS= read -r e; do
            [[ -z "$e" ]] && continue
            if [[ "$e" == */ ]]; then subs+=("${e%/}"); else files+=("$e"); fi
        done < <(cd -- "$dir" 2>/dev/null && ls -1tp 2>/dev/null)

        titulo "📂 $(short "$dir")"
        if [[ ! -r "$dir" ]]; then warn "No puedo leer esta carpeta"; fi
        if (( ${#subs[@]} + ${#files[@]} == 0 )); then dim " (carpeta vacía)"; fi

        for e in "${subs[@]:0:15}"; do
            ((i++)); ent[i]="${dir%/}/$e"; kind[i]="d"
            printf ' %s[%d]%s 📁 %s/\n' "$C_G" "$i" "$C_0" "$(recortar "$e" 32)"
        done
        for e in "${files[@]:0:30}"; do
            ((i++)); ent[i]="${dir%/}/$e"; kind[i]="f"
            printf ' %s[%d]%s %s %s %s(%s)%s\n' "$C_G" "$i" "$C_0" "$(icono "$e")" \
                "$(recortar "$e" 26)" "$C_D" "$(tamano "${ent[i]}")" "$C_0"
        done
        if (( ${#files[@]} > 30 )); then dim " ... y $(( ${#files[@]} - 30 )) archivos más (los más nuevos arriba)"; fi
        echo
        dim " Varios archivos: 2 5 7"
        dim " s = compartir ESTA carpeta"
        dim " c 2 = compartir la carpeta/archivo 2"
        dim " u = subir · 0 = otra carpeta · q = salir"
        read -rp " ➜ " ans || return 1

        case "${ans,,}" in
            q)  return 1 ;;
            0)  dir=""; continue ;;
            u)  dir="$(dirname -- "$dir")"; continue ;;
            s)  SEL=("$(readlink -f -- "$dir")"); return 0 ;;
            "") continue ;;
        esac

        # "c 2 3": comparte tal cual lo elegido (carpetas incluidas)
        if [[ "${ans,,}" == c\ * ]]; then
            SEL=(); bad=false
            for tok in ${ans#* }; do
                if [[ "$tok" =~ ^[0-9]+$ ]] && [[ -n "${ent[$((10#$tok))]:-}" ]]; then
                    SEL+=("$(readlink -f -- "${ent[$((10#$tok))]}")")
                else
                    bad=true
                fi
            done
            if $bad || (( ${#SEL[@]} == 0 )); then
                warn "Opción no válida"; sleep 1; continue
            fi
            return 0
        fi

        local picks=() ndir=0; bad=false
        for tok in $ans; do
            if [[ "$tok" =~ ^[0-9]+$ ]]; then
                tok=$((10#$tok))
                if [[ -n "${ent[tok]:-}" ]]; then
                    picks+=("$tok")
                    [[ "${kind[tok]}" == "d" ]] && ((ndir++))
                    continue
                fi
            fi
            bad=true
        done

        if $bad || (( ${#picks[@]} == 0 )); then
            warn "Opción no válida"; sleep 1; continue
        fi
        if (( ndir == 1 && ${#picks[@]} == 1 )); then
            dir="${ent[${picks[0]}]}"; continue
        fi
        if (( ndir > 0 )); then
            warn "No mezcles carpetas y archivos"; sleep 1; continue
        fi
        SEL=()
        for p in "${picks[@]}"; do
            SEL+=("$(readlink -f -- "${ent[p]}")")
        done
        return 0
    done
}

