main() {
    local args=() files_arg=() a v

    while (( $# )); do
        case "$1" in
            -h|--help)    uso; exit 0 ;;
            -v|--version) echo "BarbaShare v$VERSION · por $AUTOR"; exit 0 ;;
            -a|--acerca)  acerca; exit 0 ;;
            --instalar)    instalar_comando; exit $? ;;
            --desinstalar) desinstalar_comando; exit 0 ;;
            -z|--zip)     ZIP_FIXED=true; shift ;;
            -n|--sin-reproductor) PLAYER_OFF=true; shift ;;
            -r|--recibir) RECV=true; shift ;;
            --youtube)    TUBE=true; shift ;;
            --probar)     PROBAR=true; shift ;;
            --actualizar) ACTUALIZAR=true; shift ;;
            -p|--clave)
                if (( $# >= 2 )) && [[ "$2" != -* ]]; then
                    PASSWORD="$2"; shift 2
                else
                    PASSWORD="auto"; shift
                fi
                ;;
            -t|--tiempo)
                [[ "${2:-}" =~ ^[0-9]+$ ]] || { err "Falta el número de minutos tras $1"; exit 1; }
                EXPIRA_MIN=$((10#$2)); shift 2
                ;;
            -x|--max)
                [[ "${2:-}" =~ ^[0-9]+$ ]] || { err "Falta el número tras $1"; exit 1; }
                MAX_ACCESOS=$((10#$2)); shift 2
                ;;
            -m|--metodo)
                if (( $# < 2 )); then err "Falta el método tras $1"; exit 1; fi
                case "${2,,}" in
                    auto)                       METODO="auto" ;;
                    cloudflared|cloudflare|cf)  METODO="cloudflared" ;;
                    pinggy)                     METODO="pinggy" ;;
                    lhr|localhost.run)          METODO="lhr" ;;
                    serveo)                     METODO="serveo" ;;
                    tuns|tuns.sh)               METODO="tuns" ;;
                    lt|localtunnel)             METODO="lt" ;;
                    local|lan|wifi)             METODO="local" ;;
                    self|este|localhost)        METODO="self" ;;
                    *) err "Método no válido: $2"; uso; exit 1 ;;
                esac
                METODO_FIJO=true
                shift 2
                ;;
            *) args+=("$1"); shift ;;
        esac
    done

    [[ "$PASSWORD" == "auto" ]] && PASSWORD="$(aleatoria)"

    preparar_entorno || exit 1

    if $ACTUALIZAR; then actualizar_ytdlp; exit 0; fi
    if $PROBAR; then probar_servidores; exit 0; fi
    if $TUBE; then flujo_tube; exit 0; fi
    if $RECV; then
        flujo_recibir "${args[0]:-}"
        exit 0
    fi

    for a in "${args[@]}"; do
        if [[ -e "$a" ]]; then
            files_arg+=("$(readlink -f -- "$a")")
        else
            err "No existe: $a"; exit 1
        fi
    done

    if (( ${#files_arg[@]} )); then
        SEL=("${files_arg[@]}")
        $METODO_FIJO || elegir_metodo
        compartir
        exit 0
    fi

    menu_principal
    echo
    ok "Hasta pronto 👋  · BarbaShare by $AUTOR"
}

main "$@"
